# =============================================================================
#  sre-agent POC — environment variables template
#  Copy to `.env` and fill in your own values. `.env` is git-ignored.
# =============================================================================

# Google Gemini API key (free tier: https://aistudio.google.com/apikey)
# Used by trace-agent + rca-agent + remediator-agent via the kagent ModelConfig
# bound in manifests/modelconfig/gemini-2-flash-lite.yaml.
# The placeholder value `dummy-replace-with-real-key` is fine for proving the
# controller wiring works, but every LLM call will 401 until you set a real key.
GEMINI_API_KEY=dummy-replace-with-real-key

# Optional: Slack incoming webhook for allow/deny notifications.
# Leave empty if you don't want Slack notifications.
# Free to test: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK=

# LLM provider for the agents (openai | gemini | anthropic | ollama).
# Default is openai (gpt-4o-mini). See manifests/modelconfig/.
PROVIDER=openai

# Required when PROVIDER=openai or PROVIDER=anthropic. Leave blank for gemini.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required when PROVIDER=ollama (local model server).
OLLAMA_HOST=http://host.docker.internal:11434