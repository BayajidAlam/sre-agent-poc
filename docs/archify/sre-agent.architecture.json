  "cards": [
    { "dot": "cyan",    "title": "Trigger Path (Alertmanager)",      "items": ["Prometheus fires an alert when /api/payment error rate crosses threshold", "Alertmanager receives the alert and POSTs the IncidentContext webhook to kagent-controller", "kagent-controller routes the A2A message to the trace-agent in agent-read ns"] },
    { "dot": "emerald", "title": "3-Agent A2A Pipeline",             "items": ["trace-agent (RO) queries Prometheus + Loki + Tempo via MCP shims to gather evidence", "rca-agent reasons over the runbook (git-mcp), k8s state, and emits a typed RCAFinding", "kagent 0.7 rejects A2A peer refs that form cycles; the caller (kagent-controller) chains trace -> rca -> remediator"] },
    { "dot": "rose",    "title": "Defense in Depth",                 "items": ["OPA Rego allow-list + confidence >= 0.7 + risk != high", "policy-mcp-shim -> policy-mcp -> OPA chain returns default-deny on any error", "agent-read SA is view-only; agent-write SA scoped to specific verbs in apps-demo"] },
    { "dot": "amber",   "title": "Recovery Loop",                    "items": ["remediator-agent calls kagent-tools k8s_rollout(action=undo) on allow=true", "Kubernetes rolls the payment Deployment back from v2 to v1 (~30s)", "remediator-agent posts a Slack notification and creates an Alertmanager silence"] }
